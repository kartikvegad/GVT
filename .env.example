# Copy to .env.local and fill in real values. Never commit .env.local.

# Gmail account used to send form emails (2FA + App Password required)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where inquiry emails should arrive (defaults to GMAIL_USER if omitted)
CONTACT_TO=info@gvtworld.com

# Optional: WhatsApp Cloud API confirmation to the customer after form submit
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_TEMPLATE_BODY_PARAMS=2
# WHATSAPP_API_VERSION=v21.0
